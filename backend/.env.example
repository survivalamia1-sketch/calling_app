# Server Configuration
PORT=8080
ENV=development
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=calling_app
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=720

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxx

# ==================================================
# Email Configuration (TurboSMTP)
# ==================================================
# Server: pro.turbo-smtp.com
# Authentication: Required (Enabled)
#
# Get your credentials from TurboSMTP Dashboard:
# 1. Login to https://www.serversmtp.com/
# 2. Go to SMTP & API section
# 3. Copy your Consumer Key (SMTP_USERNAME)
# 4. Copy your Consumer Secret (SMTP_PASSWORD)
#
# Available Ports:
# ----------------
# SSL/TLS Direct:    465 (recommended for SSL), 25025
# STARTTLS:          587 (recommended), 25, 2525
# ==================================================

# SMTP Server Configuration
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587

# TurboSMTP Credentials (REQUIRED)
# Replace with your actual Consumer Key and Consumer Secret
SMTP_USERNAME=your-consumer-key-from-turbosmtp
SMTP_PASSWORD=your-consumer-secret-from-turbosmtp

# Sender Email (must be verified in TurboSMTP dashboard)
SMTP_FROM=noreply@yourapp.com
SMTP_FROM_NAME=Calling App

# SMTP Security Settings
# For Port 587 (STARTTLS - Recommended):
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_SKIP_VERIFY=false

# For Port 465 (Direct SSL):
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
# SMTP_SKIP_VERIFY=false

# For Port 25025 (Alternative SSL):
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
# SMTP_SKIP_VERIFY=false

# For Port 2525 (Alternative STARTTLS):
# SMTP_USE_SSL=false
# SMTP_USE_TLS=true
# SMTP_SKIP_VERIFY=false

# APP URL for email links (verification, password reset)
APP_URL=http://localhost:3000

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# WebRTC / STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=debug
